# Python caches
__pycache__/
*.py[cod]

# Local compiler and test caches
.torchinductor_cache/
.cache/
.pytest_cache/
.mypy_cache/

# Machine-local model links, weights, and task locks
geo/out/target_local/
.claude/*.lock

# Agent worktrees and per-user agent settings
.claude/worktrees/
.claude/settings.local.json

# Results, figures, checkpoints and run logs are artifacts (R2 is the durable store)
out/
figures/
/results/
wandb/
*.pt
*.pth
*.safetensors

# Local scratch: temporary snapshots, page renders, reference clones
/tmp/

# Editor and OS metadata
.DS_Store
*.swp

# Local secrets
.env
.env.*
*.pem
*.key

# Third-party clone for reference (goodfire-ai/spd)
spd_lib/

# Local reference documents (proposal PDFs etc.)
/*.pdf


# Local copies of the base model and its verification
matryoshka/data/

# Write-ups stay out of git (kept on disk); only the project instructions are tracked
*.md
!CLAUDE.md
